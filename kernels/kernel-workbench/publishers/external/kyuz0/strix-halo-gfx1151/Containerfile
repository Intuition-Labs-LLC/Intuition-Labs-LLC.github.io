ARG ROCM_IMAGE=docker.io/kyuz0/vllm-therock-gfx1151@sha256:f89c8c689ade28877ade980ba0f29b3142af16c6ebb7f3f285311d38bc81a8a2
FROM ${ROCM_IMAGE}

COPY kernel-workbench/publishers/external/kyuz0/strix-halo-gfx1151/requirements-cuda12.9.lock /tmp/requirements-cuda12.9.lock
RUN /opt/venv/bin/python3 -m pip install --no-cache-dir --require-hashes \
    -r /tmp/requirements-cuda12.9.lock \
    && mkdir -p /opt/cuda-12.9/include \
    && cp -a /opt/venv/lib/python3.12/site-packages/nvidia/cuda_runtime/include/. \
        /opt/cuda-12.9/include/ \
    && cp -a /opt/venv/lib/python3.12/site-packages/nvidia/cuda_nvcc/include/. \
        /opt/cuda-12.9/include/ \
    && cp -a /opt/venv/lib/python3.12/site-packages/nvidia/cuda_cccl/include/. \
        /opt/cuda-12.9/include/ \
    && cp -a /opt/venv/lib/python3.12/site-packages/nvidia/curand/include/. \
        /opt/cuda-12.9/include/ \
    && ln -s /opt/venv/lib/python3.12/site-packages/nvidia/cuda_nvcc/bin \
        /opt/cuda-12.9/bin \
    && ln -s /opt/venv/lib/python3.12/site-packages/nvidia/cuda_nvcc/nvvm \
        /opt/cuda-12.9/nvvm

ENV CUDA_PATH=/opt/cuda-12.9

LABEL org.opencontainers.image.title="Kernel Workbench CUDA to HIP ROCm toolchain"
LABEL org.opencontainers.image.description="Pinned gfx1151 ROCm/HIPIFY image with supported CUDA 12.9 headers"
LABEL org.opencontainers.image.base.name="docker.io/kyuz0/vllm-therock-gfx1151@sha256:f89c8c689ade28877ade980ba0f29b3142af16c6ebb7f3f285311d38bc81a8a2"
LABEL org.opencontainers.image.documentation="https://rocm.docs.amd.com/projects/HIPIFY/en/latest/"
